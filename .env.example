# Copy to .env at the project root. The CLI loads .env automatically.
# Existing process environment variables take precedence.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_BASE_URL=https://app.neatlogs.com/api/v1/public

# Full trace context uses Neatlogs' documented read-only MCP tool.
# This project key is distinct from the Public API service-account token.
NEATLOGS_API_KEY=
NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp

# Select a real Jevals backend explicitly with --jevals-backend vercel or typesafe.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# Optional LangChain investigation: enable with --llm-investigation.
OPENAI_API_KEY=
INVESTIGATOR_MODEL=
